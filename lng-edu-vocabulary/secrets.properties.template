# Шаблон файла с секретами.  @tag:secrets
#
# Скопировать рядом под именем secrets.properties и вписать значения:
#
#     cp secrets.properties.template secrets.properties
#
# secrets.properties закрыт .gitignore и в репозиторий не попадает — это
# единственное место, где пароль лежит открытым текстом. В git едет только этот
# шаблон. Что куда вписывать — README.md, раздел «Секреты».
#
# Файл читают оба потребителя, оба ищут его в корне репозитория:
#   - бэкенд (Spring Boot) — через spring.config.import в application.yaml;
#   - конвертер данных (:importer:migrate) — сам, при запуске.

# Подключение к локальной базе Postgres.
# Роль и база заводятся вручную, см. README.md.
vocabulary.db.url=jdbc:postgresql://localhost:5432/vocabulary
vocabulary.db.username=vocabulary
vocabulary.db.password=

